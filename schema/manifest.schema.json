{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aiescrow/manifest.schema.json",
  "title": "User-State Escrow v0.1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["escrow_id", "depositor", "beneficiary_id_hash", "created_at", "artefacts", "release_conditions", "holder", "signatures"],
  "properties": {
    "escrow_id": {"type": "string", "minLength": 1},
    "depositor": {"$ref": "#/$defs/party"},
    "beneficiary_id_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the beneficiary X25519 public key bytes"},
    "created_at": {"type": "string", "format": "date-time", "description": "UTC ISO-8601"},
    "artefacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "kind", "sha256", "size", "encryption"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["model_weights", "fine_tune", "memory", "history", "config", "other"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the encrypted file"},
          "size": {"type": "integer", "minimum": 0, "description": "bytes of the encrypted file"},
          "plaintext_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "encryption": {"enum": ["x25519"]}
        }
      }
    },
    "release_conditions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {"enum": ["vendor_shutdown", "acquisition", "deprecation", "deadman", "court_order"]},
          "params": {"type": "object"}
        }
      }
    },
    "holder": {"$ref": "#/$defs/holder"},
    "signatures": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "pubkey", "sig"],
        "properties": {
          "role": {"const": "depositor"},
          "pubkey": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sig": {"type": "string", "pattern": "^[0-9a-f]{128}$", "description": "ed25519 over canonical JSON (sorted keys, no spaces) of the manifest without signatures"}
        }
      }
    }
  },
  "$defs": {
    "holder": {
      "type": "object", "additionalProperties": false, "required": ["name", "pubkey"],
      "properties": {
        "name": {"type": "string"},
        "pubkey": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "type": {"type": "string"}
      }
    },
    "party": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "pubkey": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "type": {"type": "string"}
      }
    }
  }
}
